{
  "name": "pact-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute pact-db --remote --file schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "tc": "tsc --noEmit",
    "check": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "dayjs": "catalog:",
    "hono": "catalog:",
    "nanoid": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4"
  }
}
