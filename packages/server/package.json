{
  "name": "@a16n/pact-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "schema.sql"
  ],
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tc": "tsc --noEmit",
    "check": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "dayjs": "catalog:",
    "hono": "catalog:",
    "nanoid": "catalog:",
    "qrcode-generator": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/qrcode-generator": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
