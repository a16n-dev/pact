{
  "name": "@a16n/pact-react",
  "version": "0.1.0",
  "description": "React bindings for @a16n/pact-client with TanStack Query: a store provider and sign-in and sync hooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a16n-dev/pact.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/a16n-dev/pact#readme",
  "bugs": "https://github.com/a16n-dev/pact/issues",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tc": "tsc --noEmit -p tsconfig.test.json",
    "check": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write ."
  },
  "peerDependencies": {
    "@a16n/pact-client": "workspace:^",
    "@tanstack/react-query": "^5",
    "react": ">=19"
  },
  "devDependencies": {
    "@a16n/pact-client": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
