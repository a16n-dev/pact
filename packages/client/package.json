{
  "name": "@a16n/pact-client",
  "version": "1.1.0",
  "description": "Local-first document store with optional sync, realtime, blobs, migrations, and end-to-end encryption — the client half of Pact.",
  "license": "UNLICENSED",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tc": "tsc --noEmit -p tsconfig.test.json",
    "check": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "dayjs": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
